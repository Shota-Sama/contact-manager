# Secret used to sign session cookies. Set a long random string in production
# (on Vercel: Project Settings -> Environment Variables).
AUTH_SECRET=change-me-to-a-long-random-string

# Base URL of the ASP.NET Core backend (ContactManager.Api).
# Local default: http://127.0.0.1:5197
# On Render, set this to your API's public URL, e.g. https://your-api.onrender.com
CONTACT_MANAGER_API_URL=http://127.0.0.1:5197

# Optional: override the Nominatim reverse-geocoding endpoint.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=contact-manager/1.0
